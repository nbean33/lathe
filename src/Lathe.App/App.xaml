<Application x:Class="Lathe.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:Lathe.App.Infrastructure">
    <Application.Resources>
        <SolidColorBrush x:Key="Accent" Color="#2F6FB5"/>
        <SolidColorBrush x:Key="Danger" Color="#C62828"/>
        <SolidColorBrush x:Key="Ok" Color="#2E7D32"/>
        <SolidColorBrush x:Key="Panel" Color="#F4F6F9"/>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <inf:SeverityBrush x:Key="SevBrush"/>
        <inf:SeverityIcon x:Key="SevIcon"/>
        <inf:InverseBool x:Key="Not"/>
        <inf:CheckBrush x:Key="CheckBrush"/>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,2,6,2"/>
            <Setter Property="MinHeight" Value="26"/>
        </Style>
        <Style x:Key="Big" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>
        <Style x:Key="Stop" TargetType="Button" BasedOn="{StaticResource Big}">
            <Setter Property="Background" Value="#FFD7D7"/>
            <Setter Property="BorderBrush" Value="#C62828"/>
        </Style>
        <Style x:Key="Go" TargetType="Button" BasedOn="{StaticResource Big}">
            <Setter Property="Background" Value="#D9F2DC"/>
            <Setter Property="BorderBrush" Value="#2E7D32"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate><TextBlock Text="{Binding}" FontWeight="SemiBold" Foreground="#2F3B4C"/></DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Dro" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <DataTemplate x:Key="IssueTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Severity, Converter={StaticResource SevIcon}}" Foreground="{Binding Severity, Converter={StaticResource SevBrush}}" Width="18" FontWeight="Bold"/>
                <TextBlock Text="{Binding Where}" FontWeight="SemiBold" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>
    </Application.Resources>
</Application>
